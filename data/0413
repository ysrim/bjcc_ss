        }
        h1 {
            color: #2c3e50;
            font-size: 1.6em; 
            text-align: center;
            border-bottom: 2px solid #3498db;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        h2 {
            color: #2980b9;
            font-size: 1.2em; 
            margin-top: 25px;
            margin-bottom: 10px;
            border-left: 4px solid #2980b9;
            padding-left: 10px;
        }
        h3 {
            color: #34495e;
            font-size: 1.05em; 
            margin-top: 20px;
            margin-bottom: 10px;
        }
        p, li {
            margin-bottom: 10px;
        }
        .script-box {
            background-color: #f9fbfd;
            border: 1px solid #e1e8ed;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .highlight {
            font-weight: bold;
            color: #d35400;
        }
        .bible-verse {
            background-color: #eef2f5;
            padding: 15px;
            font-size: 0.95em; 
            font-style: italic;
            border-radius: 8px;
            text-align: center;
            margin: 15px 0;
            color: #2c3e50;
        }

        /* 인쇄용(Print) 최적화 스타일 - 폰트 크기 축소 */
        @media print {
            @page {
                size: A4;
                margin: 15mm; 
            }
            body {
                background-color: #fff;
                padding: 0;
                color: #000;
            }
            .container {
                box-shadow: none;
                padding: 0;
                max-width: 100%;
            }
            p, li {
                line-height: 1.5; 
                font-size: 11pt; 
                margin-bottom: 6pt;
            }
            h1 {
                font-size: 16pt; 
                margin-bottom: 15pt;
                padding-bottom: 10pt;
                border-bottom: 2px solid #000;
            }
            h2 {
                font-size: 13pt; 
                margin-top: 20pt;
                margin-bottom: 10px;
                border-left: 4px solid #000;
                color: #000;
            }
            h3 {
                font-size: 12pt; 
                margin-top: 15pt;
                margin-bottom: 8pt;
                color: #000;
            }
            ul, ol {
                margin-top: 5pt;
                margin-bottom: 10pt;
                padding-left: 20pt;
            }
            .script-box {
                border: 1px solid #aaa;
                background-color: #fafafa !important;
                -webkit-print-color-adjust: exact;
                color-adjust: exact;
                padding: 12pt;
                margin-bottom: 15pt;
                page-break-inside: avoid;
                break-inside: avoid;
            }
            .bible-verse {
                border: 1px solid #ccc;
                background-color: #f5f5f5 !important;
                -webkit-print-color-adjust: exact;
                font-size: 11.5pt; 
                font-weight: bold;
                padding: 12pt;
                margin: 15pt 0;
            }
            .highlight {
                color: #000;
                text-decoration: underline; 
            }
        }
